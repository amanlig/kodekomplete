!/coveredCallOptimizer/tests/test_public_calculations.js
!/coveredCallOptimizer/tests/test_public_portfolio.py
/coveredCallOptimizer/**/__pycache__/
/coveredCallOptimizer/**/*.pyc
/coveredCallOptimizer/.secrets/
/coveredCallOptimizer/data/
/coveredCallOptimizer/reports/
/coveredCallOptimizer/status/
/coveredCallOptimizer/archive/

